# Copy to backend/.env for local development; or .env at repo root for Compose.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
AI_TIMEOUT_SECONDS=90
MAX_UPLOAD_MB=20
MAX_ROWS=200000
MAX_COLUMNS=100
MAX_DATASETS=100
MAX_SESSION_DATASETS=5
MAX_STORE_MB=500
DATASET_TTL_SECONDS=7200
DATA_DIR=/tmp/datalens-datasets
CHART_POINT_LIMIT=2000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=false
